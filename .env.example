# Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# Alpha Vantage (free tier: 25 req/day)
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here

# NewsAPI (free tier: 100 req/day)
NEWS_API_KEY=your_newsapi_key_here

# Finnhub (optional) — preferred US per-ticker news when set; free tier 60 req/min.
# Leave blank to fall back to free yfinance/Yahoo news.
FINNHUB_API_KEY=

# FRED (US macro data)
FRED_API_KEY=your_fred_api_key_here

# Telegram watchlist alerts (optional) — create a bot with @BotFather for the
# token; get your chat id by messaging the bot, then visiting
# https://api.telegram.org/bot<TOKEN>/getUpdates (the "chat":{"id":...} field).
# Leave blank to keep alerts dormant (logged on the server, never sent).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# WATCH_MOVE_ALERT_PCT=0.03          # day move vs previous close that pings
# WATCH_MOVE_REALERT_STEP_PCT=0.02   # extra move before pinging the same day again
# WATCH_INSIDER_BUYS_ONLY=false      # true = skip bearish insider alerts (sells)
# WATCH_INTERVAL_MINUTES=15

# Model overrides (optional — defaults live in config/settings.py)
# Verify exact IDs against your provider dashboards; a wrong string fails at
# runtime (Claude/GPT track will log an error and skip that call).
# CLAUDE_DECISION_MODEL=claude-sonnet-5
# CLAUDE_ERL_MODEL=claude-opus-4-8
# CLAUDE_ERL_EXTENDED_THINKING=true       # adaptive thinking on Opus 4.8
# CLAUDE_ERL_EFFORT=high                   # output_config.effort: low|medium|high|max
# CLAUDE_PROMPT_MODEL=claude-opus-4-8     # MIPRO instruction proposer (Claude track)
# GPT_DECISION_MODEL=gpt-5
# GPT_NEWS_MODEL=gpt-5-mini               # shared news analysis (both tracks)
# GPT_ERL_MODEL=gpt-5.6-sol
# GPT_ERL_REASONING_EFFORT=high           # high|medium|low|minimal; empty disables
# GPT_PROMPT_MODEL=gpt-5.6-sol             # MIPRO instruction proposer (GPT track)

# App settings
LOG_LEVEL=INFO
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000
RESET_PIN=3821

# Risk / exit tuning (optional — defaults in config/settings.py)
# MAX_POSITION_PCT=0.25              # position value cap as fraction of equity
# TRAILING_STOP_ATR_MULTIPLIER=2.0   # trail distance in ATRs once in profit
# Per-market capital cap (fraction of each track's equity). Reserves room so the
# long US session can't fill the whole book before Stockholm opens. JSON; a
# market omitted or set >= 1.0 is uncapped. e.g. tilt toward Nordic:
# MARKET_ALLOCATION={"nordic": 0.6, "us": 0.4}

# Regime classification (optional)
# HURST_ON_RETURNS=false   # true = textbook R/S on log returns; measures return
                           # persistence properly but drifting walks then read
                           # neutral and the screener gets much stricter.
                           # Flip deliberately and watch candidate volume.

# Counterfactual MIPRO training (optional)
# COUNTERFACTUAL_HORIZON_DAYS=14     # forward window for labeling PASS decisions
# COUNTERFACTUAL_BUY_THRESHOLD=0.03  # fwd return >= this = missed BUY (no-exit fallback)
# COUNTERFACTUAL_MAX_EXAMPLES=30     # cap so hindsight labels can't swamp real trades

# Housekeeping (optional)
# DECISIONS_RETENTION_DAYS=90        # weekly prune of old decision rows; 0 disables
# DB_BACKUP_KEEP=7                   # nightly SQLite snapshots kept in data/backups/; 0 disables

# Dashboard HTTP Basic Auth (leave DASHBOARD_PASSWORD empty to disable)
DASHBOARD_USER=deepswing
DASHBOARD_PASSWORD=

# MIPRO artifact backup (optional but recommended)
# Local git working copy of a standalone backups repo. After each MIPRO run the
# new compiled program is copied here (full timestamped history + latest.json),
# committed, and pushed. The working copy's remote must have push credentials.
# Empty = backup disabled. One-time setup on the Pi:
#   git clone git@github.com:<you>/deepswing-mipro-backups.git ~/Github/deepswing-mipro-backups
MIPRO_BACKUP_REPO_DIR=
MIPRO_BACKUP_PUSH=true

# --- Prediction-market track (Kalshi weather contracts) ---
# Modelled as market="events" with its own cash pools (claude_events / gpt_events),
# so event P&L never contaminates the Claude-vs-GPT equity comparison. Set
# EVENT_TRACKS=[] to disable the track entirely — every wiring point is guarded.
#
# Both APIs are public and need no key. Verify them on the Pi before trusting output:
#   venv/bin/python scripts/check_event_sources.py
#
# Leave the dry run ON until the calibration plot on the Events tab looks sound —
# it logs and sizes every edge but opens nothing.
EVENT_DRY_RUN=true
EVENT_SCAN_INTERVAL_MINUTES=20
EVENT_DAYS_AHEAD=10
# EVENT_SERIES=["KXHIGHNY","KXHIGHCHI","KXHIGHMIA","KXHIGHDEN","KXHIGHLAX","KXHIGHAUS"]

# Kalshi has served public market data under more than one host. If requests
# 404 or refuse, switch to https://api.elections.kalshi.com/trade-api/v2
# KALSHI_API_BASE=https://external-api.kalshi.com/trade-api/v2
# NWS asks API clients to identify themselves; put a contact address here.
# NWS_USER_AGENT=DeepSwing/0.1 (you@example.com)

# Edge floor in probability points. Above the ~0.05 the retail write-ups quote,
# because that figure ignores Kalshi's fee (1.75c on a 50c contract = 3.5% of stake).
MIN_EVENT_EDGE=0.07
KELLY_FRACTION=0.25
MAX_EVENT_POSITION_PCT=0.02
MAX_EVENT_POSITIONS=20

# Forecast uncertainty in degF: sigma at one day of lead, widening per extra day.
# Seeded from published NWS MAE — recalibrate from the Events tab once contracts settle.
FORECAST_SIGMA_DAY1=2.5
FORECAST_SIGMA_PER_DAY=1.0

# Contracts are USD, portfolios are SEK. Used when financedata FX is unavailable.
USD_SEK_FALLBACK=10.5
